# =====================================================
# File: .gitignore
# Property: Long-term repository file
# =====================================================

# Runtime ETL logs and profiling outputs
/logs/

# Legacy ETL log path
/scripts/etl_log.txt

# Other log files
*.log

# Temporary and backup files
*.tmp
*.bak
*.backup
*.swp
*~
.prepare_engineering_*

# Compressed and packaged files
*.zip
*.rar
*.7z
*.tar
*.gz

# Database / connection configuration
*.env
.env
*.ini
*.conf
db_config.*
config_local.*

# Local database user credentials
/mysql/02_create_retail_bi_users.local.sql

# Full-size data files (never commit to Git)
data/raw/*
!data/raw/.gitkeep
data/generated/*
!data/generated/.gitkeep
*.manifest.json

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Trae IDE
.trae/

# Local environment files
.env.local
.env.*.local

# Python cache
__pycache__/
*.pyc
