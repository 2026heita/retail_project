# =====================================================
# File: .gitignore
# Property: Long-term repository file
# =====================================================

# Runtime ETL logs and profiling outputs
/logs/

# Legacy ETL log path
/scripts/etl_log.txt

# Other log files
*.log

# Temporary and backup files
*.tmp
*.bak
*.swp
*~

# Compressed and packaged files
*.zip
*.rar
*.7z
*.tar
*.gz

# Database / connection configuration
*.env
.env
*.ini
*.conf
db_config.*
config_local.*

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Trae IDE
.trae/

# Local environment files
.env.local
.env.*.local
